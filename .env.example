# ─────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/find_event_platform

# ─────────────────────────────────────────────
# JWT Secrets (CHANGE THESE IN PRODUCTION!)
# ─────────────────────────────────────────────
JWT_ACCESS_SECRET=your_super_secret_access_token_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_token_change_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─────────────────────────────────────────────
# ImageKit (https://imagekit.io — free tier)
# ─────────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# ─────────────────────────────────────────────
# Brevo SMTP (https://brevo.com — 300 emails/day free)
# ─────────────────────────────────────────────
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_login_email
BREVO_SMTP_PASS=your_brevo_smtp_key
MAIL_FROM=no-reply@yourapp.com

# ─────────────────────────────────────────────
# PayPal (https://developer.paypal.com — sandbox free)
# ─────────────────────────────────────────────
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ─────────────────────────────────────────────
# Client
# ─────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
